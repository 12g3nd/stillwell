{
  "name": "stillwell",
  "version": "0.1.0",
  "private": true,
  "description": "An offline Windows photo editor with editable layers and local version history",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "package": "npm run build && electron-builder --win dir"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "saxes": "6.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "fabric": "7.4.0",
    "pdfjs-dist": "6.3.289",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "zod": "4.6.5"
  },
  "build": {
    "appId": "app.stillwell.desktop",
    "productName": "Stillwell",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/proof.*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}
